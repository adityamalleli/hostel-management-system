PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hostel_management
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ATTENDANCE_WINDOW_START=19:00
ATTENDANCE_WINDOW_END=22:00
ATTENDANCE_LATE_AFTER=20:30

# QR attendance
ATTENDANCE_REQUIRE_QR=true
QR_TOKEN_TTL_SECONDS=40

# Deployment (set these on the hosting dashboard, not in git)
CLIENT_ORIGIN=https://your-frontend.vercel.app
TZ=Asia/Kolkata
